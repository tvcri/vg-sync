# The test harness's environment: invented data only. See
# docs/superpowers/specs/2026-11-13-test-harness-design.md. Copy to .env.harness (gitignored) and fill in.

# The service, as the harness runs it (main.js --env .env.harness)
LGL_API_KEY=
# The trial account's stand-ins for the membership fund and PayPal payment type.
# node harness/discover.js --env .env.harness prints both ids. The fund
# ("Harness Membership") it creates by API. The API cannot create payment
# types; on the trial account the existing "Credit Card" type stands in for
# PayPal (ordinary scenario gifts use Check or Cash).
LGL_MEMBERSHIP_FUND_ID=
LGL_PAYPAL_PAYMENT_TYPE_ID=
VG_API_URL=
VG_OIDC_URL=
VG_CLIENT_ID=
VG_CLIENT_SECRET=
VG_SCOPE=vg
CIRCUIT_BREAKER_PEOPLE=1000
# A small trial account makes any deleted scenario constituent look like a large drop; the drop check gets its own runAlone scenario later.
MAX_CONSTITUENT_DROP_PERCENT=100

# The harness's own VG client, making edits as staff would
HARNESS_VG_CLIENT_ID=vg-sync-harness
HARNESS_VG_CLIENT_SECRET=

# The dev database, for reseeding (generator) and restoring the two accounts' grants
HARNESS_DB_CONTAINER=village-green-orch-db-1
HARNESS_DB_HOST=127.0.0.1
HARNESS_DB_PORT=60001
HARNESS_DB_USER=root
HARNESS_DB_PASSWORD=
HARNESS_DB_SCHEMA=vg
# The app's demo-data generator (village-green/data), run with npm run seed
# HARNESS_GENERATOR_DIR=~/dev/village-green/data

# Optional (harness/seed.js): ids for ordinary scenario gifts. Needed only when
# the trial account has no gift type named "Gift", no fund other than the
# membership stand-in, or no "Check" or "Cash" payment type.
# LGL_GIFT_TYPE_ID=
# LGL_ORDINARY_FUND_ID=
# LGL_ORDINARY_PAYMENT_TYPE_ID=
